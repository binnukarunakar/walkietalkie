# All optional — the server boots with sane defaults. Never commit real values.
PORT=8080
HOST=0.0.0.0
# 32+ chars. Omit to generate per boot (single instance only). openssl rand -hex 32
SESSION_SECRET=
# Mesh cap per room (2-16). Above ~10 a full mesh stops being a good idea.
MAX_CHANNEL_SIZE=9
# Comma-separated STUN URLs.
STUN_URLS=stun:stun.l.google.com:19302
# Optional TURN relay for hostile NATs — all three together or none.
TURN_URL=
TURN_USERNAME=
TURN_CREDENTIAL=
# POST /api/join requests allowed per IP per minute.
JOIN_RATE_MAX=10
# Set true ONLY behind a reverse proxy/load balancer, so rate limiting keys on
# the real client IP. If exposed directly, leave false (spoofable header).
TRUST_PROXY=false
LOG_LEVEL=info
